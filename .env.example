# ─── Paths ────────────────────────────────────────────────────────────────────
# Folder on macOS where Voice Record Pro saves .m4a + sidecar files
AUDIO_FOLDER=/Users/your_user/Library/CloudStorage/GoogleDrive-.../My Drive/VoiceMemos

# Obsidian vault root
VAULT_PATH=/Users/your_user/Library/CloudStorage/GoogleDrive-.../My Drive/Obsidian/Vault

# Sub-folder inside vault where new notes are dropped
INBOX_FOLDER=00 Inbox

# SQLite database that tracks processed files, tags and links
PROCESSED_DB=/Users/your_user/Documents/Python/Whisper2Obsidian/data/w2o.db

# ─── Whisper ──────────────────────────────────────────────────────────────────
# mlx-whisper model (HuggingFace repo or local path)
# Full large-v3 – best accuracy (~3 GB, 1.5B params)
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# Faster turbo variant (~1.5 GB, 809M params): WHISPER_MODEL=mlx-community/whisper-large-v3-mlx

# ─── LLM Providers ────────────────────────────────────────────────────────────
# You can use either Groq or Cerebras (or both). Provide at least one API key.

# --- Groq ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cerebras ---
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_MODEL=gpt-oss-120b

# ─── Groq Rate Limits (configurable, defaults match free-tier with safety buffer)
# Set slightly below hard Groq limits to avoid 429 errors
GROQ_RPM_LIMIT=28      # Groq free cap: 30 req/min
GROQ_TPM_LIMIT=11000   # Groq free cap: 12 000 tokens/min
GROQ_RPD_LIMIT=950     # Groq free cap: 1 000 req/day

# ─── Cerebras Rate Limits (configurable, defaults match free-tier with safety buffer)
CEREBRAS_RPM_LIMIT=30     # Cerebras free cap: 30 req/min
CEREBRAS_TPM_LIMIT=64000  # Cerebras free cap: 64,000 tokens/min
CEREBRAS_RPD_LIMIT=14400  # Cerebras free cap: 14,400 req/day

# ─── Logging / CLI ────────────────────────────────────────────────────────────
# Set to DEBUG for verbose output, INFO for normal, WARNING for quiet
LOG_LEVEL=INFO

# Print live Groq rate-usage table after each pipeline run (true/false)
SHOW_RATE_USAGE=false
